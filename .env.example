# Copie este arquivo para .env (dev local) e/ou configure as mesmas
# variáveis nas Environment Variables do projeto na Vercel.

# Obrigatória — chave de API da Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional — para quem os e-mails de contato/candidatura são enviados.
# Padrão: sucessodocliente@domingosassessoria.com.br
CONTACT_EMAIL_TO=sucessodocliente@domingosassessoria.com.br

# Opcional — remetente dos e-mails. Antes de verificar o domínio
# domingosassessoria.com.br na Resend, use o domínio de teste deles
# (onboarding@resend.dev). Depois de verificar o domínio, troque para
# algo como: "Site Domingos Assessoria <formulario@domingosassessoria.com.br>"
RESEND_FROM_EMAIL=Site Domingos Assessoria <onboarding@resend.dev>
